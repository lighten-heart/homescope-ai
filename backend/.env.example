HOMESCOPE_APP_NAME=HomeScope AI
HOMESCOPE_APP_VERSION=0.1.0
HOMESCOPE_DEBUG=false
HOMESCOPE_HOST=127.0.0.1
HOMESCOPE_PORT=8000
# LLM配置
HOMESCOPE_LLM_ENABLED=false
HOMESCOPE_LLM_PROVIDER=custom
HOMESCOPE_LLM_MODEL_ID=your-model-name
HOMESCOPE_LLM_API_KEY=your-api-key
HOMESCOPE_LLM_BASE_URL=https://your-provider.example.com/v1
# 高德地图MCP
HOMESCOPE_AMAP_ENABLED=false
HOMESCOPE_AMAP_API_KEY=your-amap-web-service-key
HOMESCOPE_AMAP_MCP_PACKAGE=@amap/amap-maps-mcp-server
# Agent运行控制
HOMESCOPE_AGENT_TIMEOUT_SECONDS=90
HOMESCOPE_AGENT_RETRY_ATTEMPTS=2
HOMESCOPE_AGENT_RETRY_BASE_DELAY_SECONDS=0.5
HOMESCOPE_MAP_CACHE_TTL_SECONDS=1800
HOMESCOPE_ALLOW_DEGRADED_MODE=true